<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: connection status + tools -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRotate"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_btn"
                android:contentDescription="Rotate"
                android:src="@drawable/ic_rotate" />

            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_btn"
                android:contentDescription="Keyboard"
                android:src="@drawable/ic_keyboard" />

            <ImageButton
                android:id="@+id/btnShortcuts"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_btn"
                android:contentDescription="Shortcuts"
                android:src="@drawable/ic_command" />

            <ImageButton
                android:id="@+id/btnMedia"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_btn"
                android:contentDescription="Media keys"
                android:src="@drawable/ic_media" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/icon_btn"
                android:contentDescription="Settings"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Pad, with the pairing screen on top while not connected -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <com.glidepad.app.TrackpadView
                android:id="@+id/pad"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ScrollView
                android:id="@+id/connectPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_launcher_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Connect to your Mac"
                        android:textColor="@color/text"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/connectStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/enableBtn"
                        style="@style/PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_marginTop="24dp" />

                    <LinearLayout
                        android:id="@+id/firstTimeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/card"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            style="@style/Caption"
                            android:text="PAIR A NEW MAC" />

                        <LinearLayout
                            android:id="@+id/steps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/makeVisibleBtn"
                            style="@style/PrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_marginTop="18dp"
                            android:text="Make phone visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pairedCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="10dp">

                        <TextView
                            style="@style/Caption"
                            android:text="PAIRED COMPUTERS" />

                        <LinearLayout
                            android:id="@+id/pairedList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pairHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="Paired this phone with the Mac before? Remove it on both devices first, then pair again so the Mac sees it as a trackpad and keyboard."
                        android:textColor="@color/text3"
                        android:textSize="13sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Optional physical-style click buttons -->
        <LinearLayout
            android:id="@+id/clickBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <View
                android:id="@+id/leftBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/click_btn"
                android:contentDescription="Left click" />

            <View
                android:id="@+id/rightBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/click_btn"
                android:contentDescription="Right click" />
        </LinearLayout>

        <!-- Tool panels (one at a time) -->
        <HorizontalScrollView
            android:id="@+id/keyRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/keyRowContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/shortcutPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mediaPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <com.glidepad.app.KeyInputView
            android:id="@+id/keyInput"
            android:layout_width="1dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Settings sheet -->
    <FrameLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.glidepad.app.SheetView
            android:id="@+id/settingsSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="72dp"
            android:background="@drawable/sheet"
            android:clickable="true"
            android:focusable="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="20dp" />
        </com.glidepad.app.SheetView>
    </FrameLayout>
</FrameLayout>
